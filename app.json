{
  "expo": {
    "name": "Gallery",
    "slug": "apple-style-gallery",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.example.applestylegallery",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#F5F5F2"
      },
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Gallery to access your photos and videos.",
          "savePhotosPermission": "Allow Gallery to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}